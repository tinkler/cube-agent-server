# ============================================================
# Cube Agent Server - 环境变量模板
# 复制为 .env 后填实际值;.env 已被 .gitignore 排除
# 加载优先级: 环境变量 > .env 文件 > agent.yaml
# ============================================================

# DeepSeek LLM API Key(AI skill 用)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# HTTP 服务端口(可覆盖 agent.yaml 的 server.http_addr)
# CUBE_AGENT_HTTP_ADDR=:8080

# 日志级别(可覆盖 agent.yaml 的 log.level)
# CUBE_AGENT_LOG_LEVEL=debug

# 关闭 ANSI 颜色(Windows 上某些终端需要)
# CUBE_AGENT_LOG_NO_COLOR=true
